# =============================================================================
# TrackerAssist backend configuration
# Copy to `.env` and fill in. Nothing here is committed.
# The app runs WITHOUT any of these set (uses local/fake fallbacks) so you can
# boot and demo before credentials arrive.
# =============================================================================

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL. Default is a local SQLite file; no server required.
DATABASE_URL=sqlite:///./trackerassist.db

# --- Redmine (issue source) -------------------------------------------------
REDMINE_URL=https://tracker.ceph.com
# Optional: a read-only API key. Public trackers work without it (lower limits).
REDMINE_API_KEY=
# Restrict scraping to one project identifier (e.g. "rbd"); blank = all.
REDMINE_PROJECT_ID=

# --- GitHub (PR source) -----------------------------------------------------
# Fine-grained PAT with "Pull requests: read" + "Metadata: read".
# Anonymous access is capped at 60 req/hr and will not survive polling.
GITHUB_TOKEN=
# Comma-separated "owner/name" repos to watch, e.g. "ceph/ceph,ceph/ceph-csi".
GITHUB_REPOS=ceph/ceph

# --- watsonx.ai (Granite models) --------------------------------------------
# Leave blank to fall back to LocalEmbedder (sentence-transformers) or the
# built-in HashEmbedder. Set all four to use real Granite embeddings.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_EMBED_MODEL_ID=ibm/granite-embedding-278m-multilingual

# Force a specific embedder backend: "auto" (default), "watsonx", "local", "hash".
EMBEDDER_BACKEND=auto

# --- Matching / scheduling --------------------------------------------------
# Minimum cosine similarity for a PR<->issue link suggestion (0..1).
LINK_MIN_SIMILARITY=0.72
# Poll cadence for open items (minutes) and closed items (hours).
SYNC_OPEN_MINUTES=15
SYNC_CLOSED_HOURS=6
# Cap issues/PRs pulled per source (keeps demo fast). 0 = no cap.
MAX_ISSUES=2000
MAX_PULLS=500

# --- Local ingest -----------------------------------------------------------
# If set, sync_redmine loads issues from this folder of raw *.json files
# (produced by the original prototype's scraper) instead of hitting the API.
RAW_ISSUES_DIR=
