# =============================================================================
# TrackerAssist backend configuration
# Copy to `.env` and edit. Nothing here is committed.
#
# It runs with ZERO changes on the public Ceph tracker using local Granite
# embeddings. The settings below are ordered by how likely you are to touch
# them: RECOMMENDED first, then OPTIONAL, then advanced.
# =============================================================================

# -----------------------------------------------------------------------------
# SECURITY — set both of these before any shared/hosted deployment
# -----------------------------------------------------------------------------

# Comma-separated list of origins allowed to call this API (CORS).
# Set to your extension's chrome-extension:// origin and any hosted dashboard.
# Example: chrome-extension://abcdefghijklmnopabcdefghijklmnop,https://trackerassist.example.com
# Default (localhost only) is safe for local dev; never leave * in production.
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Shared secret required on all profile and recommendation endpoints.
# Set in the extension popup under "API key". Leave blank for local dev only.
API_KEY=

# -----------------------------------------------------------------------------
# RECOMMENDED — set these for a real run
# -----------------------------------------------------------------------------

# Which GitHub repos to watch for pull requests. Comma-separated "owner/name".
GITHUB_REPOS=ceph/ceph

# GitHub token. Anonymous access is capped at 60 requests/hour and will not
# survive polling; a token raises that to 5,000/hour.
# Make a fine-grained PAT (github.com > Settings > Developer settings) with
# read-only "Pull requests: read" + "Metadata: read", scoped to the repos above.
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# EMBEDDINGS — how issues/PRs get turned into vectors
# -----------------------------------------------------------------------------
# Default runs IBM's open Granite model LOCALLY (no watsonx account, no quota).
# Requires: pip install sentence-transformers
# Leave EMBEDDER_BACKEND=auto; it uses watsonx only if the keys below are set,
# otherwise the local Granite model, otherwise a deterministic hash fallback.
EMBEDDER_BACKEND=auto

# Local (Hugging Face) Granite model. Alternatives:
#   ibm-granite/granite-embedding-125m-english   (smaller/faster, English only)
#   all-MiniLM-L6-v2                              (non-Granite, tiny)
LOCAL_EMBED_MODEL=ibm-granite/granite-embedding-278m-multilingual

# -----------------------------------------------------------------------------
# OPTIONAL — watsonx.ai (only if you HAVE credits; local Granite is the default)
# -----------------------------------------------------------------------------
# Set all four to route embeddings through managed watsonx instead of local.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_EMBED_MODEL_ID=ibm/granite-embedding-278m-multilingual

# -----------------------------------------------------------------------------
# OPTIONAL — Redmine (defaults to the public Ceph tracker; no key needed)
# -----------------------------------------------------------------------------
REDMINE_URL=https://tracker.ceph.com
# Only needed for private projects or higher rate limits ("My account" > API key).
REDMINE_API_KEY=
# Restrict to one project identifier (e.g. "rbd"); blank = all projects.
REDMINE_PROJECT_ID=

# -----------------------------------------------------------------------------
# OPTIONAL — dashboard, tuning, and scheduling
# -----------------------------------------------------------------------------
# If set, /dashboard requires ?token=<this>. Blank = open (fine on localhost).
DASHBOARD_TOKEN=

# If set, POST /admin/rescrape requires ?token=<this> (or an X-Admin-Token
# header). Blank = open. Set this in any shared/hosted deployment since the
# endpoint triggers scraping.
ADMIN_TOKEN=

# Minimum cosine similarity for a PR<->issue suggestion (0..1).
LINK_MIN_SIMILARITY=0.72

# Issue-page "possible match" PRs: baseline for the calibrated confidence
# display, and the minimum raw cosine to show a possible match. Lower
# RELATED_PR_MIN_SIMILARITY (toward SIMILARITY_FLOOR) to see more potential PRs;
# raise it toward 0.80 if they feel noisy.
SIMILARITY_FLOOR=0.70
RELATED_PR_MIN_SIMILARITY=0.74
# Two-hop suggestions: PRs recorded as fixing a highly similar tracker are shown
# "via similar tracker #N". Only siblings above this issue<->issue cosine count
# (issue<->issue scores much higher than issue<->PR, hence the higher bar).
RELATED_VIA_ISSUE_MIN_SIMILARITY=0.80

# Possible-duplicate warning on issue pages. High bar on purpose: a duplicate
# warning must be high-precision or people stop trusting it. Raise toward 0.92
# if it fires too often; lower toward 0.85 to catch looser duplicates.
DUPLICATE_MIN_SIMILARITY=0.88
DUPLICATE_LIMIT=3

# Hybrid scoring: content similarity stays the base ranker; these add bounded
# structural boosts/penalties. Grid-search them against your real #ref links with
# `python scripts/tune_weights.py`. The defaults below were tuned to 70.0% top-1
# on 34k Ceph links (the branch match dominates; the component signal is weak).
HYBRID_BRANCH_WEIGHT=0.30       # tracker number encoded in the PR head branch
HYBRID_COMPONENT_WEIGHT=0.03    # PR and issue in the same Ceph subsystem
HYBRID_COMPONENT_PENALTY=0.05   # PR and issue in clearly different subsystems

# Recommendations: boost for issues in the user's historical components, so
# familiar-area work ranks higher even in a broad search (0 = pure content).
REC_COMPONENT_WEIGHT=0.05

# Cross-encoder reranking: an optional precision stage that re-reads the top-K
# candidates (issue + PR together). Runs locally on a small model (free,
# offline). Kept OFF by default: measured on 34k real tracker<->PR links with
# scripts/eval_linkage.py, the stock ms-marco cross-encoder HURT accuracy badly
# (top-1 ~69% hybrid -> ~37% reranked). It is trained for web-search Q&A, not
# issue/PR matching, so it discards the subsystem/branch signal the hybrid
# scorer relies on. The plumbing stays (swap RERANKER_MODEL for a code-tuned
# cross-encoder and re-measure), but do not enable it with this default model.
RERANK_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=25
RERANK_MIN_SCORE=0.10

# Poll cadence: open items every N minutes, closed items every N hours.
SYNC_OPEN_MINUTES=15
SYNC_CLOSED_HOURS=6

# Cap items pulled per source to keep the demo fast. 0 = no cap.
MAX_ISSUES=2000
MAX_PULLS=500

# SQLAlchemy database URL. Default is a local SQLite file; no server needed.
DATABASE_URL=sqlite:///./trackerassist.db

# Ingest issues from a folder of raw *.json files instead of the Redmine API
# (e.g. a previous scrape). Blank = scrape the API normally.
RAW_ISSUES_DIR=
