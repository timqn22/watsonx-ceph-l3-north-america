# GitHub Configuration
# IMPORTANT: Leave empty or add your own valid token
# Empty = 60 requests/hour (unauthenticated)
# With token = 5000 requests/hour
# Get token at: https://github.com/settings/tokens (only need 'public_repo' scope)
GITHUB_TOKEN=
GITHUB_REPO=ceph/ceph

# Ceph Tracker Configuration
CEPH_TRACKER_URL=https://tracker.ceph.com
CEPH_PROJECT_ID=

# Embedding Model Configuration (no API key needed!)
# Options: 'all-MiniLM-L6-v2' (fast, 384 dim) or 'all-mpnet-base-v2' (best quality, 768 dim)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./models

# Service Configuration
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=5000

# Recommendation Settings
SIMILARITY_THRESHOLD=0.75
MAX_RECOMMENDATIONS=10

# Cache Settings
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=ceph_linker.log